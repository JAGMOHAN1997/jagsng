project_name         = "myapp"
environment          = "dev"
aws_region           = "us-east-1"
allowed_ssh_cidr     = "203.0.113.10/32"
ec2_instance_type    = "t3.micro"
ec2_key_name         = "my-keypair"
db_name              = "myappdb"
